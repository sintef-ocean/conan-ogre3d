From 19aee703536d08546bf3559a3a6996e62db67ef5 Mon Sep 17 00:00:00 2001
From: Joakim Haugen <joakim.haugen@sintef.no>
Date: Tue, 19 May 2026 13:05:27 +0200
Subject: [PATCH 5/5] Add optional imgui 32-bit indices

---
 CMake/Templates/imconfig.h                  | 6 +++++-
 CMakeLists.txt                              | 1 +
 Components/Overlay/src/OgreImGuiOverlay.cpp | 3 ++-
 3 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/CMake/Templates/imconfig.h b/CMake/Templates/imconfig.h
index 7f6a28ce2..6ab13e904 100644
--- a/CMake/Templates/imconfig.h
+++ b/CMake/Templates/imconfig.h
@@ -2,4 +2,8 @@
 #define IMGUI_DISABLE_OBSOLETE_FUNCTIONS
 #include <OgreOverlayPrerequisites.h>
 #define IMGUI_API _OgreOverlayExport
-#cmakedefine IMGUI_ENABLE_FREETYPE
\ No newline at end of file
+#cmakedefine IMGUI_ENABLE_FREETYPE
+#cmakedefine OGRE_IMGUI_USE_32BIT_INDICES
+#ifdef OGRE_IMGUI_USE_32BIT_INDICES
+#define ImDrawIdx unsigned int
+#endif
\ No newline at end of file
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7b564a273..e0fd2e460 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -333,6 +333,7 @@ option(OGRE_WITH_QT "Build with QT support" FALSE)
 option(OGRE_WITH_SDL "Build with SDL2 support" FALSE)
 
 cmake_dependent_option(OGRE_BUILD_COMPONENT_OVERLAY_IMGUI "Include dear imgui in Overlays" TRUE "OGRE_BUILD_COMPONENT_OVERLAY" FALSE)
+cmake_dependent_option(OGRE_IMGUI_USE_32BIT_INDICES "Use 32-bit indices for ImGui" FALSE "OGRE_BUILD_COMPONENT_OVERLAY_IMGUI" FALSE)
 
 cmake_dependent_option(OGRE_BUILD_COMPONENT_BITES "Build OgreBites component" TRUE "OGRE_BUILD_COMPONENT_OVERLAY" FALSE)
 cmake_dependent_option(OGRE_BUILD_COMPONENT_BULLET "Build Bullet physics component" TRUE "BULLET_FOUND" FALSE)
diff --git a/Components/Overlay/src/OgreImGuiOverlay.cpp b/Components/Overlay/src/OgreImGuiOverlay.cpp
index a080e1c78..a5b2506ee 100644
--- a/Components/Overlay/src/OgreImGuiOverlay.cpp
+++ b/Components/Overlay/src/OgreImGuiOverlay.cpp
@@ -437,7 +437,8 @@ void ImGuiOverlay::ImGUIRenderable::updateVertexData(ImDrawData* draw_data)
         mRenderOp.indexData->indexBuffer->getNumIndexes() < size_t(draw_data->TotalIdxCount))
     {
         mRenderOp.indexData->indexBuffer = HardwareBufferManager::getSingleton().createIndexBuffer(
-            HardwareIndexBuffer::IT_16BIT, draw_data->TotalIdxCount, HBU_CPU_TO_GPU);
+            sizeof(ImDrawIdx) == 2 ? HardwareIndexBuffer::IT_16BIT : HardwareIndexBuffer::IT_32BIT,
+            draw_data->TotalIdxCount, HBU_CPU_TO_GPU);
     }
 
     // Copy all vertices
-- 
2.47.3

